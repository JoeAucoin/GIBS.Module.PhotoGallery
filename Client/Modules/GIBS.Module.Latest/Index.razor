@using GIBS.Module.PhotoGallery.Services
@using GIBS.Module.PhotoGallery.Models
@using System.Text.Json
@using Microsoft.AspNetCore.Components
@using System.Net

@namespace GIBS.Module.PhotoGallery.Latest
@inherits ModuleBase
@inject IAlbumService AlbumService
@inject IPhotoService PhotoService
@inject ISettingService SettingService
@inject IStringLocalizer<Index> Localizer
@inject IPageService PageService
@inject IPageModuleService PageModuleService

@if (_showAllAlbumsPhotos && _albumId == -1)
{
    @if (_items == null)
    {
        <p><em>Loading items...</em></p>
    }
    else if (_items.Count == 0)
    {
        <p>@Localizer["Message.DisplayNone"]</p>
    }
    else
    {
        <div class="container-fluid">
            <div class="multi-carousel-container" id="multiCarousel">
                <div class="multi-carousel-inner" id="carouselInner">
                    @for (var index = 0; index < _items.Count; index++)
                    {
                        var item = _items[index];
                        <div class="multi-carousel-item" data-index="@index">
                            <div class="img-container">
                                @if (_displayIndexNumber)
                                {
                                    <span class="item-number">@(index + 1)</span>
                                }
                                <a href="@BuildPhotoUrl(item.PhotoId, item.AlbumId)">
                                    <img src="@item.ThumbnailPath" alt="@item.Title - @item.AlbumName" title="@BuildPhotoTitle(item)" loading="lazy" />
                                </a>
                                @if (_showPhotoTitle)
                                {
                                    <div class="carousel-title-overlay">
                                        <h2 class="carousel-title">@item.Title</h2>
                                    </div>
                                }
                            </div>
                        </div>
                    }
                </div>

                <button class="multi-carousel-control-prev" id="prevBtn" type="button" aria-label="Previous slide">
                    <span class="carousel-control-prev-icon" aria-hidden="true"></span>
                </button>
                <button class="multi-carousel-control-next" id="nextBtn" type="button" aria-label="Next slide">
                    <span class="carousel-control-next-icon" aria-hidden="true"></span>
                </button>
            </div>
        </div>
    }
}
else if (_albumId == -1)
{
    @if (_albums == null)
    {
        <p><em>Loading...</em></p>
    }
    else
    {
        @if (_albums.Count != 0)
        {
            <div class="row row-cols-1 row-cols-sm-2 row-cols-md-3 row-cols-lg-4 g-4">
                @foreach (var album in _albums)
                {
                    <div class="col">
                        <div class="card h-100 shadow-sm">
                            <a href="@BuildAlbumUrl(album.AlbumId)">
                                <img class="card-img-top" src="@album.ThumbnailPath" alt="@album.AlbumName" loading="lazy" />
                            </a>
                            <div class="card-body">
                                <h5 class="card-title mb-1">
                                    <a class="text-decoration-none" href="@BuildAlbumUrl(album.AlbumId)">@album.AlbumName</a>
                                </h5>
                                <small class="text-muted">@album.ItemCount photos</small>
                            </div>
                        </div>
                    </div>
                }
            </div>
        }
        else
        {
            <p>@Localizer["Message.DisplayNone"]</p>
        }
    }
}
else
{
    <div class="container">
       

        @if (_subAlbums != null && _subAlbums.Any())
        {
            <h3 class="pw-subalbums-title">📁 Sub-Albums</h3>
            <div class="piwigo-gallery" id="piwigoSubGallery">
                <div class="pw-albums-grid pw-subalbums-grid">
                    @foreach (var album in _subAlbums)
                    {
                        <div class="pw-album-card pw-subalbum-card">
                            <div class="pw-album-thumb">
                                @if (!string.IsNullOrEmpty(album.ThumbnailPath))
                                {
                                    <a href="@BuildAlbumUrl(album.AlbumId)">
                                        <img class="pw-album-img" src="@album.ThumbnailPath" alt="@album.AlbumName" loading="lazy" />
                                    </a>
                                }
                                <div class="pw-album-overlay"></div>
                            </div>
                            <div class="pw-album-info">
                                <h2 class="pw-album-title">
                                    <a href="@BuildAlbumUrl(album.AlbumId)">@album.AlbumName</a>
                                </h2>
                                <span class="pw-album-count">@album.ItemCount photos</span>
                            </div>
                        </div>
                    }
                </div>
            </div>
        }

       

        @if (_slideshowPhotoId.HasValue)
        {
            var current = _items.FirstOrDefault(i => i.PhotoId == _slideshowPhotoId.Value);
            var currentIndex = current != null ? _items.FindIndex(i => i.PhotoId == current.PhotoId) : -1;
            <div class="text-center mb-3">
                <div class="pw-slideshow-content">
                    @if (current != null)
                    {
                        <img src="@current.FilePath" alt="@current.Title" title="@BuildPhotoTitle(current)" />
                    }
                </div>
                <div class="d-flex align-items-center justify-content-between mt-3">
                    <div class="pw-slideshow-nav">
                        @if (currentIndex > 0)
                        {
                            <a class="pw-slideshow-prev" href="@BuildPhotoUrl(_items[currentIndex - 1].PhotoId)">
                                <i class="oi oi-arrow-circle-left" style="font-size: 32px;"></i>
                            </a>
                        }
                    </div>
                    <div class="text-center">
                        @if (current != null)
                        {
                            <h3 class="pw-slideshow-title">@current.Title</h3>
                            @if (!string.IsNullOrEmpty(current.Description))
                            {
                                <div class="pw-slideshow-desc">@current.Description</div>
                            }
                            <div class="pw-slideshow-counter">@(currentIndex + 1) / @_items.Count</div>
                        }
                        <div class="mt-3">
                            <a class="btn btn-secondary" href="@BuildAlbumUrl(_albumId)">Back to Album</a>
                        </div>
                    </div>
                    <div class="pw-slideshow-nav">
                        @if (currentIndex >= 0 && currentIndex < _items.Count - 1)
                        {
                            <a class="pw-slideshow-next" href="@BuildPhotoUrl(_items[currentIndex + 1].PhotoId)">
                                <i class="oi oi-arrow-circle-right" style="font-size: 32px;"></i>
                            </a>
                        }
                    </div>
                </div>
            </div>
        }
        else
        {
            
            @if (_items == null)
            {
                <p><em>Loading items...</em></p>
            }
            else if (_items.Count == 0)
            {
                <p>@Localizer["Message.DisplayNone"]</p>
            }
            else
            {
                <div class="container-fluid">
                    <div class="multi-carousel-container" id="multiCarousel">
                        <div class="multi-carousel-inner" id="carouselInner">
                            @for (var index = 0; index < _items.Count; index++)
                            {
                                var item = _items[index];
                                <div class="multi-carousel-item" data-index="@index">
                                    <div class="img-container">
                                        @if (_displayIndexNumber)
                                        {
                                            <span class="item-number">@(index + 1)</span>
                                        }
                                        <a href="@BuildPhotoUrl(item.PhotoId)">
                                            <img src="@item.ThumbnailPath" alt="@item.Title - @item.AlbumName" title="@BuildPhotoTitle(item)" loading="lazy" />
                                        </a>
                                        @if (_showPhotoTitle)
                                        {
                                            <div class="carousel-title-overlay">
                                                <h2 class="carousel-title">@item.Title</h2>
                                            </div>
                                        }
                                    </div>
                                </div>
                            }
                        </div>

                        <button class="multi-carousel-control-prev" id="prevBtn" type="button" aria-label="Previous slide">
                            <span class="carousel-control-prev-icon" aria-hidden="true"></span>
                        </button>
                        <button class="multi-carousel-control-next" id="nextBtn" type="button" aria-label="Next slide">
                            <span class="carousel-control-next-icon" aria-hidden="true"></span>
                        </button>
                    </div>
                </div>
            }
        }
    </div>
}



@code {
    public override string RenderMode => RenderModes.Static;

    // public override List<Resource> Resources => new List<Resource>()
    // {
    //     new Stylesheet("Modules/GIBS.Module.PhotoGallery/Latest.css?v=5"),
    //     new Script("Modules/GIBS.Module.PhotoGallery/Module.js?v=2")
    // };

    public override List<Resource> Resources => new List<Resource>()
    {
        new Resource { ResourceType = ResourceType.Stylesheet, Url = "Modules/GIBS.Module.PhotoGallery/Latest.css?v=5" },
        new Resource { ResourceType = ResourceType.Script, Level = ResourceLevel.Site, Url = "Modules/GIBS.Module.PhotoGallery/Module.js?v=2" }

    };

    private List<PhotoAlbum> _albums;
    private List<PhotoAlbum> _subAlbums;
    private List<Photo> _items;
    private List<Photo> _albumItems;
    private string _selectedTag;
    private int _albumId = -1;
    private int? _slideshowPhotoId;
    private string _selectedAlbumName;
    private Photo _selectedItem;
    private bool _showPhotoTitle;
    private bool _displayIndexNumber;
    private bool _sortByModifiedOn;
    private bool _showAllAlbumsPhotos;
    private int? _moduleIdOfPhotoGallery;
    private int? _defaultAlbumId;
    private List<string> _photoGalleryModulePaths = new();
    private string _photoGalleryModulePath;

    private int PhotoGalleryModuleId => _moduleIdOfPhotoGallery.GetValueOrDefault(ModuleState.ModuleId);

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var settings = await SettingService.GetModuleSettingsAsync(ModuleState.ModuleId);
            _showPhotoTitle = bool.Parse(SettingService.GetSetting(settings, "ShowPhotoTitle", "true"));
            _displayIndexNumber = bool.Parse(SettingService.GetSetting(settings, "DisplayIndexNumber", "true"));
            _sortByModifiedOn = bool.Parse(SettingService.GetSetting(settings, "SortByModifiedOn", "false"));
            _showAllAlbumsPhotos = bool.Parse(SettingService.GetSetting(settings, "ShowAllAlbumsPhotos", "false"));
            if (int.TryParse(SettingService.GetSetting(settings, "ModuleIdOfPhotoGallery", ModuleState.ModuleId.ToString()), out var moduleId))
            {
                _moduleIdOfPhotoGallery = moduleId;
            }

            await LoadPhotoGalleryModulePathsAsync();

            if (int.TryParse(SettingService.GetSetting(settings, "AlbumId", string.Empty), out var defaultAlbumId))
            {
                _defaultAlbumId = defaultAlbumId;
            }
            if (PageState.QueryString.ContainsKey("album") && int.TryParse(PageState.QueryString["album"], out var albumId))
            {
                _albumId = albumId;
                _selectedTag = PageState.QueryString.ContainsKey("tag") ? System.Uri.UnescapeDataString(PageState.QueryString["tag"]) : null;
                await LoadAlbumItems();

              

            }
            else
            {
                _slideshowPhotoId = null;
             
                _selectedItem = null;
                _selectedTag = null;

                if (_showAllAlbumsPhotos)
                {
                    _albumId = -1;
                    await LoadAllAlbumsPhotos();
                }
                else if (_defaultAlbumId.HasValue && _defaultAlbumId.Value > 0)
                {
                    _albumId = _defaultAlbumId.Value;
                    await LoadAlbumItems();
                }
                else
                {
                    _albumId = -1;
                    await LoadAlbums();
                }
            }
        }
        catch (Exception ex)
        {
            await logger.LogError(ex, "Error Loading Gallery {Error}", ex.Message);
            AddModuleMessage(Localizer["Message.LoadError"], MessageType.Error);
        }
    }

    private async Task LoadPhotoGalleryModulePathsAsync()
    {
        _photoGalleryModulePaths.Clear();
        _photoGalleryModulePath = null;

        if (!_moduleIdOfPhotoGallery.HasValue)
        {
            return;
        }

        var selectedModuleId = _moduleIdOfPhotoGallery.Value;

        PageModule currentPageModule = null;
        try
        {
            currentPageModule = await PageModuleService.GetPageModuleAsync(PageState.Page.PageId, selectedModuleId);
        }
        catch
        {
            currentPageModule = null;
        }

        if (currentPageModule != null && !string.IsNullOrWhiteSpace(PageState.Page.Path))
        {
            _photoGalleryModulePaths.Add(PageState.Page.Path);
        }

        var pages = await PageService.GetPagesAsync(PageState.Site.SiteId);
        foreach (var page in pages)
        {
            if (page.PageId == PageState.Page.PageId)
            {
                continue;
            }

            PageModule pageModule = null;
            try
            {
                pageModule = await PageModuleService.GetPageModuleAsync(page.PageId, selectedModuleId);
            }
            catch
            {
                pageModule = null;
            }

            if (pageModule != null && !string.IsNullOrWhiteSpace(page.Path) && !_photoGalleryModulePaths.Contains(page.Path))
            {
                _photoGalleryModulePaths.Add(page.Path);
            }
        }

        _photoGalleryModulePath = _photoGalleryModulePaths.FirstOrDefault();
    }

    private string BuildAlbumUrl(int albumId)
    {
        var baseUrl = string.IsNullOrWhiteSpace(_photoGalleryModulePath) ? NavigateUrl() : NavigateUrl(_photoGalleryModulePath);
        return $"{baseUrl}?album={albumId}#top";
    }

    private string BuildPhotoUrl(int photoId, int? albumId = null)
    {
        var tagSegment = string.IsNullOrEmpty(_selectedTag) ? string.Empty : $"&tag={System.Uri.EscapeDataString(_selectedTag)}";
        var baseUrl = string.IsNullOrWhiteSpace(_photoGalleryModulePath) ? NavigateUrl() : NavigateUrl(_photoGalleryModulePath);
        var targetAlbumId = albumId.GetValueOrDefault(_albumId);
        return $"{baseUrl}?album={targetAlbumId}&photo={photoId}{tagSegment}";
    }

    // private string BuildLightboxUrl(int photoId)
    // {
    //     var tagSegment = string.IsNullOrEmpty(_selectedTag) ? string.Empty : $"&tag={System.Uri.EscapeDataString(_selectedTag)}";
    //     var baseUrl = string.IsNullOrWhiteSpace(_photoGalleryModulePath) ? NavigateUrl() : NavigateUrl(_photoGalleryModulePath);
    //     return $"{baseUrl}?album={_albumId}&photo={photoId}&lightbox=1{tagSegment}#top";
    // }

    private static string BuildPhotoTitle(Photo photo)
    {
        if (photo == null)
        {
            return string.Empty;
        }

        return string.IsNullOrWhiteSpace(photo.Description)
            ? photo.Title
            : $"{photo.Title} - {photo.Description}";
    }

    private static string BuildAlbumDisplayName(Album album)
    {
        if (album == null)
        {
            return "Album";
        }

        return string.IsNullOrWhiteSpace(album.Description)
            ? album.AlbumName
            : $"{album.AlbumName} - {album.Description}";
    }

    private async Task LoadAlbums()
    {
        _albums = await PhotoService.GetPhotoAlbumsAsync(PhotoGalleryModuleId);
        var albumEntities = await AlbumService.GetAlbumsAsync(PhotoGalleryModuleId);
        var topLevelAlbumIds = albumEntities.Where(a => a.ParentAlbumId == null).Select(a => a.AlbumId).ToHashSet();
        _albums = _albums.Where(a => topLevelAlbumIds.Contains(a.AlbumId)).ToList();
        _subAlbums = null;
        var firstAlbum = _albums.FirstOrDefault();
        if (firstAlbum != null)
        {
            var ogName = WebUtility.HtmlEncode(firstAlbum.AlbumName);
            var imageUrl = firstAlbum.FilePath ?? firstAlbum.ThumbnailPath;
            var baseUrl = PageState.Alias.Protocol + PageState.Alias.Name;
            var ogImage = WebUtility.HtmlEncode(baseUrl + imageUrl);
            var ogDescription = WebUtility.HtmlEncode(firstAlbum.Description);
            var pageUrl = WebUtility.HtmlEncode(baseUrl + NavigateUrl());

            AddHeadContent($"<meta property=\"og:title\" content=\"{ogName} - {Localizer["PhotoGallery"]}\" />");
            AddHeadContent($"<meta property=\"og:description\" content=\"{ogDescription}\" />");
            AddHeadContent($"<meta property=\"og:image\" content=\"{ogImage}\" />");
            AddHeadContent($"<meta property=\"og:url\" content=\"{pageUrl}\" />");
            AddHeadContent("<meta property=\"og:type\" content=\"website\" />");
        }
    }

   
    private async Task LoadAlbumItems()
    {
        var allItems = await PhotoService.GetPhotosAsync(PhotoGalleryModuleId);
        var albumEntities = await AlbumService.GetAlbumsAsync(PhotoGalleryModuleId);
        var albumLookup = albumEntities.ToDictionary(a => a.AlbumId, a => a);

        _albumItems = SortPhotos(allItems.Where(i => i.AlbumId == _albumId)).ToList();
        if (_albumItems.Any())
        {
            var selectedAlbum = albumEntities.FirstOrDefault(a => a.AlbumId == _albumId);
            var albumDisplayName = BuildAlbumDisplayName(selectedAlbum);

            _selectedAlbumName = albumDisplayName;
            UpdatePhotoOpenGraphMetadata(_albumItems.FirstOrDefault());

            foreach (var item in _albumItems)
            {
                if (item.AlbumId.HasValue && albumLookup.TryGetValue(item.AlbumId.Value, out var album))
                {
                    item.AlbumName = album.AlbumName;
                }
            }
        }
        else
        {
            var selectedAlbum = albumEntities.FirstOrDefault(a => a.AlbumId == _albumId);
            _selectedAlbumName = selectedAlbum?.AlbumName ?? "Album";
            _albumItems = new List<Photo>();
        }

        var childAlbums = albumEntities.Where(a => a.ParentAlbumId == _albumId && a.IsActive).ToList();
        _subAlbums = childAlbums
            .Select(album =>
            {
                var items = SortPhotos(allItems.Where(i => i.AlbumId == album.AlbumId)).ToList();
                var firstItem = items.FirstOrDefault();
                return new PhotoAlbum
                {
                    AlbumId = album.AlbumId,
                    AlbumName = album.AlbumName,
                    ItemCount = items.Count,
                    ThumbnailPath = firstItem?.ThumbnailPath ?? firstItem?.FilePath
                };
            })
            .ToList();

        _items = new List<Photo>(_albumItems);
       
    }


    private async Task LoadAllAlbumsPhotos()
    {
        var allItems = await PhotoService.GetPhotosAsync(PhotoGalleryModuleId);
        var albumEntities = await AlbumService.GetAlbumsAsync(PhotoGalleryModuleId);
        var albumLookup = albumEntities.ToDictionary(a => a.AlbumId, a => a.AlbumName);

        _subAlbums = null;
        _albums = new List<PhotoAlbum>();
        _albumItems = new List<Photo>();

        _items = allItems
            .OrderByDescending(i => i.ModifiedOn)
            .ThenBy(i => i.PhotoId)
            .ToList();

        foreach (var item in _items)
        {
            if (item.AlbumId.HasValue && albumLookup.TryGetValue(item.AlbumId.Value, out var albumName))
            {
                item.AlbumName = albumName;
            }
        }

        UpdatePhotoOpenGraphMetadata(_items.FirstOrDefault());
    }

    private IOrderedEnumerable<Photo> SortPhotos(IEnumerable<Photo> photos)
    {
        if (_sortByModifiedOn)
        {
            return photos.OrderByDescending(i => i.ModifiedOn).ThenBy(i => i.PhotoId);
        }

        return photos.OrderBy(i => i.SortOrder).ThenBy(i => i.PhotoId);
    }

    private void UpdatePhotoOpenGraphMetadata(Photo photo)
    {
        if (photo == null)
        {
            return;
        }

        var ogName = WebUtility.HtmlEncode(photo.Title);
        var imageUrl = photo.FilePath ?? photo.ThumbnailPath;
        var baseUrl = PageState.Alias.Protocol + PageState.Alias.Name;
        var ogImage = WebUtility.HtmlEncode(baseUrl + imageUrl);
        var ogDescription = WebUtility.HtmlEncode(photo.Description ?? photo.Title);
        var pageUrl = WebUtility.HtmlEncode(baseUrl + NavigateUrl() + $"?album={_albumId}&photo={photo.PhotoId}");

        AddHeadContent($"<meta property=\"og:title\" content=\"{ogName}\" />");
        AddHeadContent($"<meta property=\"og:description\" content=\"{ogDescription}\" />");
        AddHeadContent($"<meta property=\"og:image\" content=\"{ogImage}\" />");
        AddHeadContent($"<meta property=\"og:url\" content=\"{pageUrl}\" />");
        AddHeadContent("<meta property=\"og:type\" content=\"website\" />");
    }

}